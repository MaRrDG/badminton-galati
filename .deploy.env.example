# Copy to .deploy.env (git-ignored) and fill in. Read by scripts/deploy.sh (pnpm deploy:test).
# Placeholders only: never commit real values, this repository is public.
DEPLOY_HOST=server.example.com
DEPLOY_USER=deploy
# Absolute directory on the server that holds docker-compose.yml, nginx.conf and dist/.
DEPLOY_PATH=/srv/example-site
# Optional: private key for ssh; leave empty to use your ssh agent or ~/.ssh/config.
DEPLOY_SSH_KEY=
