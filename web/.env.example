# Where the site's content comes from: "fixtures" (src/fixtures, no network) or "sanity".
# Left empty, it is "sanity" when SANITY_PROJECT_ID is set and "fixtures" otherwise.
CONTENT_SOURCE=
# The Sanity project and dataset. The dataset is private, so the build reads it with a token.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# A read-only ("Viewer") API token from sanity.io/manage, needed when the content comes from Sanity.
# Used only by the build, on the server; it never reaches the browser. Never commit a real value.
SANITY_READ_TOKEN=
# Fixture file in src/fixtures used when CONTENT_SOURCE is "fixtures" (default home.json).
HOME_FIXTURE=
# The trial form's endpoint (plan 2b, e.g. /api/proba). Left empty, the form opens a pre-filled
# e-mail to the club and sends nothing over the network; the e2e fixture builds leave it empty.
TRIAL_ENDPOINT=
