# Where the site's content comes from: "fixtures" (src/fixtures, no network) or "sanity".
# Left empty, it is "sanity" when SANITY_PROJECT_ID is set and "fixtures" otherwise.
CONTENT_SOURCE=
# The Sanity project and dataset. The dataset is public and read-only: no token goes here.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Fixture file in src/fixtures used when CONTENT_SOURCE is "fixtures" (default home.json).
HOME_FIXTURE=
