---
import type { AthleteProfile } from '../../lib/athletes';

interface Props {
  standing: NonNullable<AthleteProfile['standing']>;
}

const { standing } = Astro.props;
---

<div class="standing">
  {/* The numeral is a picture of the place: screen readers hear it in the lead next to it.
      It rolls on load (page-motion.ts, place-roll) and holds the digits as text for no-JS
      and reduced motion. */}
  <p class="num" aria-hidden="true"><span data-roll={standing.place}>{standing.place}</span></p>
  <p class="what">{standing.lead} <span>{standing.rest}</span></p>
  {standing.source && <p class="src">{standing.source}</p>}
</div>

<style>
  .standing {
    margin-top: clamp(22px, 3vw, 36px);
    background: var(--blue);
    color: var(--white);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 4px clamp(18px, 2.4vw, 30px);
    align-items: center;
    padding: clamp(18px, 2.2vw, 26px) clamp(18px, 2.6vw, 32px);
  }
  .num {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(4.6rem, 7vw, 6rem);
    line-height: 1;
    grid-row: 1 / 3;
  }
  .what {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.25;
    align-self: end;
  }
  .what span {
    font-weight: 500;
  }
  /* Without a source line the lead sits in the middle of the numeral. */
  .what:last-child {
    align-self: center;
  }
  .src {
    font-size: 0.92rem;
    align-self: start;
    margin-top: 4px;
  }
  [data-roll] {
    display: inline-flex;
  }
  /* Digit cells the motion layer builds inside [data-roll]. */
  [data-roll] :global(i) {
    font-style: normal;
    display: block;
    height: 1em;
    overflow: hidden;
  }
  [data-roll] :global(i u) {
    text-decoration: none;
    display: block;
    height: 1em;
  }
</style>
