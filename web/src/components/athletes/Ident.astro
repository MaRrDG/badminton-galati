---
import InitialTile from '../ui/InitialTile.astro';
import PlatePhoto from '../ui/PlatePhoto.astro';
import Standing from './Standing.astro';
import type { AthleteProfile } from '../../lib/athletes';

interface Props {
  profile: AthleteProfile;
}

const { profile } = Astro.props;
const { athlete, nameLines, category, discipline, groupName, standing, tone } = profile;
---

<!-- Photo, name, facts and the place composed as one block on mist (sportiv-fisa.html). -->
<section class="ident" aria-labelledby="page-h">
  <div class="wrap">
    <div class="head">
      <a class="back textlink" href="/sportivi/">Toți sportivii</a>
      <h1 class="display" id="page-h"><span>{nameLines[0]}</span>{nameLines[1] && <> <span>{nameLines[1]}</span></>}</h1>
    </div>

    {
      athlete.photo ? (
        <PlatePhoto
          class="poster"
          img={athlete.photo}
          offset={16}
          ratio="4 / 5"
          loading="eager"
          priority
          sizes="(max-width: 860px) min(72vw, 320px), 470px"
        />
      ) : (
        /* No photo yet: the initials on the athlete's colour, with the same plate. */
        <figure class="poster initial-poster">
          <div class="plate" aria-hidden="true" />
          <InitialTile name={athlete.name} tone={tone} size="poster" />
        </figure>
      )
    }

    <div class="body">
      <dl class="facts">
        <div><dt>Categoria</dt><dd>{category ?? 'de confirmat'}</dd></div>
        {discipline && <div><dt>Proba</dt><dd>{discipline}</dd></div>}
        <div><dt>Grupa</dt><dd>{groupName ?? 'de confirmat'}</dd></div>
      </dl>
      {standing && <Standing standing={standing} />}
      {athlete.frbUrl && <p class="standing-links"><a class="textlink" href={athlete.frbUrl}>Profilul FRB</a></p>}
    </div>
  </div>
</section>

<style>
  .ident {
    background: var(--mist);
    padding: clamp(28px, 4vw, 56px) 0 clamp(40px, 5.4vw, 72px);
  }
  .ident .wrap {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-areas: 'photo head' 'photo body';
    grid-template-rows: auto 1fr;
    gap: 0 clamp(32px, 5.4vw, 80px);
  }
  .ident :global(.poster) {
    grid-area: photo;
    align-self: start;
  }
  /* The plate of PlatePhoto, for the initials (offset 16, as the photo). */
  .initial-poster {
    position: relative;
    margin: 0 16px 16px 0;
  }
  .initial-poster .plate {
    position: absolute;
    inset: 0;
    background: var(--red);
    translate: 16px 16px;
  }
  .initial-poster :global(.initial) {
    position: relative;
  }
  .head {
    grid-area: head;
    padding-top: clamp(4px, 1vw, 12px);
  }
  .back {
    display: inline-block;
    font-size: 0.98rem;
    margin-bottom: clamp(14px, 2vw, 26px);
  }
  h1 {
    font-size: clamp(2.9rem, 6vw, 5.4rem);
  }
  h1 span {
    display: block;
  }
  .body {
    grid-area: body;
    margin-top: clamp(18px, 2.4vw, 28px);
  }
  .facts {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px clamp(24px, 3.4vw, 44px);
  }
  .facts dt {
    font-size: 0.92rem;
  }
  .facts dd {
    margin: 0;
    font-weight: 600;
    font-size: 1.1rem;
  }
  .standing-links {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
  }

  @media (max-width: 860px) {
    .ident .wrap {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'head' 'photo' 'body';
      grid-template-rows: auto;
    }
    .ident :global(.poster) {
      width: min(72vw, 320px);
      margin-top: 22px;
    }
    .body {
      margin-top: 12px;
    }
  }
</style>
