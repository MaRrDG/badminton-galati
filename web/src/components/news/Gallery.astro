---
import Photo from '../ui/Photo.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { photoCountLabel, type PostPage } from '../../lib/article';

interface Props {
  mosaic: PostPage['mosaic'];
}

const { mosaic } = Astro.props;
---

<!--
  The article's photos as a mosaic on mist. Each is a plain link to the photo file; with
  JavaScript (lightbox.ts) the link opens the photo large in a dialog instead.
-->
<section class="gallery" aria-labelledby="gal-h">
  <div class="wrap">
    <div class="gal-head">
      <SectionHeading id="gal-h">Fotografii</SectionHeading>
      <p>{photoCountLabel(mosaic.length)}. Apasă pe una ca s-o vezi mare.</p>
    </div>
    <ul class="mosaic">
      {
        mosaic.map(({ img, shape }) => (
          <li class={shape || undefined}>
            <a href={img.url}>
              <Photo img={img} sizes="(max-width: 860px) 50vw, 25vw" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<dialog class="lb" aria-label="Fotografie mărită">
  <figure>
    <div class="frame"></div>
    <figcaption class="bar">
      <span class="count" aria-live="polite"></span>
      <span class="btns">
        <button type="button" data-go="-1">Anterioara</button>
        <button type="button" data-go="1">Următoarea</button>
        <button type="button" data-close>Închide</button>
      </span>
    </figcaption>
  </figure>
</dialog>

<style>
  .gallery {
    background: var(--mist);
    padding: clamp(44px, 6vw, 80px) 0;
  }
  .gal-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 6px 40px;
    margin-bottom: clamp(18px, 2.6vw, 28px);
  }
  .gal-head p {
    font-weight: 500;
  }
  .mosaic {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: clamp(120px, 14vw, 200px);
    gap: clamp(8px, 1vw, 14px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mosaic li {
    min-width: 0;
  }
  .mosaic a {
    display: block;
    height: 100%;
    background: var(--blue-deep);
  }
  .mosaic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mosaic a:hover :global(img) {
    opacity: 0.88;
  }
  .mosaic a:focus-visible {
    outline-color: var(--ink);
  }
  .big {
    grid-column: span 2;
    grid-row: span 2;
  }
  .tall {
    grid-row: span 2;
  }
  .wide {
    grid-column: span 2;
  }

  .lb {
    border: 0;
    padding: 0;
    margin: auto;
    max-width: min(94vw, 1280px);
    max-height: 92vh;
    background: transparent;
    color: var(--white);
    overflow: visible;
  }
  .lb::backdrop {
    background: var(--ink);
    opacity: 0.94;
  }
  .lb figure {
    display: grid;
    gap: 12px;
  }
  .frame :global(img) {
    display: block;
    max-width: min(94vw, 1280px);
    max-height: calc(92vh - 64px);
    width: auto;
    height: auto;
    margin: 0 auto;
    touch-action: pan-y;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 20px;
  }
  .count {
    font-weight: 500;
  }
  .btns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .lb button {
    background: var(--white);
    color: var(--ink);
    border: 0;
    font: 600 0.95rem var(--body);
    padding: 9px 14px;
    min-height: 44px;
    cursor: pointer;
  }
  .lb button:hover {
    background: var(--court);
  }
  .lb button:focus-visible {
    outline-color: var(--white);
  }
  .lb.single [data-go] {
    display: none;
  }

  @media (max-width: 860px) {
    /* Two columns: a wide photo after an odd one would leave a hole; the next photo fills it. */
    .mosaic {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: clamp(110px, 30vw, 180px);
      grid-auto-flow: row dense;
    }
    .tall {
      grid-row: span 1;
    }
  }
</style>
