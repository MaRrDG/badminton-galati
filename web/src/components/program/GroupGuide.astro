---
import Sample from '../ui/Sample.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Tbc from '../ui/Tbc.astro';
import type { ProgramPage } from '../../lib/program';

type Props = Pick<ProgramPage, 'tracks' | 'missingCoach'>;

const { tracks, missingCoach } = Astro.props;
const anyCoach = tracks.some(t => t.groups.some(g => g.coach));
const exampleCoach = tracks.some(t => t.groups.some(g => g.coachProvisional));
---

<section class="groups" id="grupe" aria-labelledby="gr-h">
  <div class="wrap">
    <div class="intro">
      <SectionHeading id="gr-h">Ce grupă i se potrivește</SectionHeading>
      <p>
        Copiii încep la Inițiere. Cine vrea competiții merge mai departe spre Performanță și Elite; cine vrea doar să joace are
        grupele de amatori.
      </p>
      {
        anyCoach && (
          <p class="small">
            {exampleCoach
              ? 'Sub fiecare grupă e numele antrenorului ei, tot ca exemplu până confirmă clubul.'
              : 'Sub fiecare grupă e numele antrenorului ei.'}
          </p>
        )
      }
      {missingCoach && <Tbc what="antrenorul fiecărei grupe." />}
      <p class="small"><a class="textlink" href="/pentru-parinti/">Întrebări de părinte: vârstă, echipament, cost</a></p>
    </div>
    {
      tracks.map(track => (
        <div class="track">
          <h3>{track.title}</h3>
          <ul>
            {track.groups.map(({ group, tone, coach, coachProvisional }) => (
              <li id={group.slug}>
                <i class:list={['sw', `t-${tone}`]} aria-hidden="true" />
                <div>
                  <b>{group.name}</b>
                  <p>{group.audience}</p>
                  {coach && (
                    <p class="coach">
                      {coachProvisional ? (
                        <Sample note="antrenor dat ca exemplu">{coach.name}</Sample>
                      ) : (
                        <>
                          {coach.name}<span class="visually-hidden">, antrenorul grupei</span>
                        </>
                      )}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .groups {
    background: var(--mist);
    padding: clamp(40px, 5.4vw, 72px) 0;
  }
  .wrap {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 28px clamp(28px, 4vw, 60px);
    align-items: start;
  }
  .intro p {
    margin-top: 12px;
    max-width: 42ch;
  }
  .intro :global(.tbc) {
    margin-top: 12px;
  }
  .small {
    font-size: 0.95rem;
  }
  h3 {
    font-family: var(--body);
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--ink-soft);
    margin-bottom: 8px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    gap: 12px;
    padding: 12px 0;
    scroll-margin-top: 16px;
  }
  b {
    font-weight: 700;
    font-size: 1.15rem;
  }
  li p {
    font-size: 0.98rem;
  }
  .coach {
    margin-top: 4px;
    font-weight: 600;
    font-size: 0.92rem;
  }

  /* The group's colour, as on its blocks in the week. */
  .sw {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 5px;
    background: var(--g);
    border: 2px solid var(--gb, var(--g));
  }
  .t-red {
    --g: var(--red-field);
  }
  .t-blue {
    --g: var(--blue);
  }
  .t-deep {
    --g: var(--blue-deep);
  }
  .t-outline {
    --g: var(--white);
    --gb: var(--blue);
  }
  .t-mist {
    --g: var(--mist);
    --gb: var(--blue-tint);
  }

  @media (max-width: 860px) {
    .wrap {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
