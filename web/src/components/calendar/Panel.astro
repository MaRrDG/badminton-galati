---
import type { EventView } from '../../lib/calendar';

interface Props {
  next?: EventView;
  countdown?: string;
  todayLabel: string;
  /** What the grid shows, so the legend names only that; without a grid, no legend and no hint. */
  legend?: { upcoming: boolean; played: boolean; home: boolean };
}

const { next, countdown, todayLabel, legend } = Astro.props;
---

{/*
  The details panel: the next competition until a block in the grid is chosen
  (calendar-panel.ts, which fills it from the templates below). Without JavaScript and on
  narrow screens it keeps the next one. The back button shows only while another is pinned.
*/}
<div class:list={['panel', next ? { home: next.home } : 'none']} data-panel data-next={next?.id}>
  <div class="pbody">
    {
      next ? (
        <>
          <p class="ps">Următoarea competiție</p>
          <p class="pd">
            <span class="pdn">{next.days}</span>
            <small class="pdm">{next.rest}</small>
          </p>
          <p class="pt">{next.title}</p>
          <p class="pc">
            <span class="pcity">{next.city}</span>
            {next.home && <span class="home-tag">acasă</span>}
          </p>
          {(next.postSlug || next.resultsUrl) && (
            <p class="pa">
              {next.postSlug && <a class="textlink" href={`/noutati/${next.postSlug}/`}>Articolul clubului</a>}
              {next.resultsUrl && <a class="textlink" href={next.resultsUrl}>Rezultatele pe badminton.ro</a>}
            </p>
          )}
          <p class="days" data-countdown data-start={next.start} data-end={next.end} hidden={!countdown}>
            {countdown}
          </p>
        </>
      ) : (
        <p class="pnone">Nicio competiție programată deocamdată.</p>
      )
    }
  </div>
  <button type="button" class="back" hidden>Arată următoarea competiție</button>
</div>
<template data-panel-event>
  <p class="ps"></p>
  <p class="pd"><span class="pdn"></span><small class="pdm"></small></p>
  <p class="pt"></p>
  <p class="pc"><span class="pcity"></span><span class="home-tag">acasă</span></p>
  <p class="pa"><a class="textlink post">Articolul clubului</a><a class="textlink results">Rezultatele pe badminton.ro</a></p>
  <p class="also">Tot în aceste zile: <button type="button" class="other"></button></p>
  <p class="days" data-countdown hidden></p>
</template>
<template data-panel-none>
  <p class="pnone">Nicio competiție programată deocamdată.</p>
</template>
<p class="visually-hidden" aria-live="polite" data-panel-live></p>
{
  legend && (
    <>
      <ul class="legend">
        <li data-legend="upcoming" hidden={!legend.upcoming}><span class="sw up" />urmează</li>
        <li data-legend="played" hidden={!legend.played}><span class="sw pl" />s-a jucat</li>
        <li data-legend="home" hidden={!legend.home}><span class="sw hm" />roșu: acasă, la Galați</li>
        <li><span class="sw td" /><span data-today-label>{todayLabel}</span></li>
      </ul>
      <p class="hint">Apasă pe o competiție din calendar ca să vezi detaliile.</p>
    </>
  )
}

<style>
  .panel {
    background: var(--blue);
    color: var(--white);
    padding: 22px 22px 24px;
  }
  .panel.home {
    background: var(--red-field);
  }
  .panel.played {
    background: var(--blue-tint);
    color: var(--ink);
  }
  .panel.played.home {
    background: var(--red-tint);
  }
  /* Nothing scheduled: one quiet line on mist. */
  .panel.none {
    background: var(--mist);
    color: var(--ink);
    padding: 18px 22px;
  }
  .ps {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .pd {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(2.8rem, 4vw, 3.6rem);
    line-height: 0.88;
    margin-top: 14px;
  }
  .pd small {
    display: block;
    font-size: 0.36em;
    font-weight: 800;
    line-height: 1.1;
    margin-top: 0.2em;
  }
  .pt {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.75rem;
    line-height: 1.02;
    margin-top: 14px;
  }
  .pc {
    margin-top: 4px;
  }
  .pa {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }
  .days {
    display: inline-block;
    margin-top: 14px;
    background: var(--white);
    color: var(--ink);
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.3rem;
    line-height: 1;
    padding: 8px 12px;
  }
  .days[hidden] {
    display: none;
  }
  .back[hidden],
  .legend li[hidden] {
    display: none;
  }
  .also {
    margin-top: 12px;
    font-size: 0.95rem;
  }
  .other {
    background: none;
    border: 0;
    padding: 0;
    margin-right: 12px;
    color: inherit;
    font: 600 0.95rem var(--body);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    cursor: pointer;
  }
  .back {
    display: block;
    margin-top: 16px;
    background: none;
    border: 0;
    padding: 0;
    color: inherit;
    font: 600 0.95rem var(--body);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    cursor: pointer;
  }
  .home-tag {
    display: inline-block;
    background: var(--white);
    color: var(--red-ink);
    font-weight: 600;
    font-size: 0.82rem;
    line-height: 1;
    padding: 4px 7px 5px;
    margin-left: 6px;
    vertical-align: 1px;
  }
  .played .home-tag {
    background: var(--red-field);
    color: var(--white);
  }

  .legend {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    gap: 9px;
    font-size: 0.93rem;
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .sw {
    flex: none;
    width: 22px;
    height: 22px;
  }
  .sw.up {
    background: var(--blue);
  }
  .sw.pl {
    background: var(--blue-tint);
  }
  .sw.hm {
    background: var(--red-tint);
  }
  .sw.td {
    background: var(--ink);
  }
  .hint {
    margin-top: 16px;
    font-size: 0.93rem;
  }

  @media (max-width: 860px) {
    .legend {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
