---
import type { Img } from '../../lib/types';
import Photo from '../ui/Photo.astro';
import PlatePhoto from '../ui/PlatePhoto.astro';

interface Props {
  text: string;
  photos: Img[];
}

const { text, photos } = Astro.props;
// A strip that can scroll is a region keyboard users must reach; one photo never scrolls.
const scrolls = photos.length > 1;
---

<section class="hall" aria-labelledby="hall-h">
  <div class="wrap">
    <div class="hall-head">
      <h2 class="display" id="hall-h">Patru terenuri pe Bulevardul Cloșca</h2>
      <p>{text}</p>
    </div>
    {
      photos.length > 0 && (
        <div class="track" role="region" aria-label="Fotografii din sală" tabindex={scrolls ? 0 : undefined}>
          {photos.map((photo, i) =>
            // The third photo carries the strip's one red plate.
            i === 2 ? (
              <PlatePhoto img={photo} offset={12} />
            ) : (
              <figure>
                <Photo img={photo} />
              </figure>
            ),
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .hall {
    background: var(--mist);
    padding: clamp(44px, 6vw, 80px) 0;
    overflow: hidden;
  }
  .hall-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px clamp(24px, 5vw, 72px);
    align-items: end;
    margin-bottom: clamp(20px, 3vw, 34px);
  }
  .hall-head h2 {
    color: var(--blue);
  }
  .hall-head p {
    max-width: 44ch;
  }
  .track {
    display: flex;
    gap: clamp(12px, 1.4vw, 20px);
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 6px;
  }
  /* The motion layer adds .js-rally and moves the strip itself. */
  :global(.js-rally) .track {
    overflow: visible;
    width: max-content;
    padding-bottom: 0;
  }
  /* The photos come from Photo and PlatePhoto, hence :global(). */
  .track > :global(figure) {
    flex: none;
  }
  .track > :global(figure) :global(img) {
    height: clamp(200px, 38vh, calc(340px + var(--lift) * 0.15));
    width: auto;
  }
  /* The plate hangs below the photo without making the strip taller. */
  .track > :global(.plated) {
    margin-bottom: 0;
  }
  /* While the strip scrolls by itself (no JS, reduced motion) the plate ends at its padding edge
     (12px offset - 6px padding), as the old box-shadow was clipped there; a plate reaching past
     it would give the strip a vertical scroll range. */
  .hall:not(.js-rally) .track > :global(.plated) :global(.plate) {
    bottom: 6px;
  }
  /* A single photo fills the column instead of running past it. */
  .track > :global(figure:only-child) {
    flex: 1 1 auto;
    min-width: 0;
  }
  .track > :global(figure:only-child) :global(img) {
    width: 100%;
    height: auto;
    max-height: clamp(200px, 38vh, calc(340px + var(--lift) * 0.15));
    object-fit: cover;
  }
  @media (max-width: 860px) {
    .hall-head {
      grid-template-columns: 1fr;
    }
  }
</style>
