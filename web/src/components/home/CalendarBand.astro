---
import { formatRangeRo, splitRangeRo } from '../../lib/dates';
import { countdownLabel, splitCalendar } from '../../lib/home';
import type { Competition } from '../../lib/types';

interface Props {
  competitions: Competition[];
  /** The build date, 'YYYY-MM-DD' in Bucharest. */
  today: string;
}

const { competitions, today } = Astro.props;
const { next, played } = splitCalendar(competitions, today);
const when = next && splitRangeRo(next.start, next.end);
const countdown = next && countdownLabel(next, today);
const year = (next?.start ?? today).slice(0, 4);
---

<section class="cal" id="calendar" aria-labelledby="cal-h">
  <div class="wrap">
    <div>
      <h2 class="display" id="cal-h">Calendar competițional</h2>
      {
        next && when ? (
          <div class="nextev">
            <p class="when">
              {when.days}
              <small>{when.rest}</small>
            </p>
            <div>
              <h3>{next.title}</h3>
              <p>{next.city}. Următoarea competiție din calendar.</p>
              <p class="days" data-countdown data-start={next.start} data-end={next.end} hidden={!countdown}>
                {countdown}
              </p>
            </div>
          </div>
        ) : (
          <p class="none">Nicio competiție programată deocamdată.</p>
        )
      }
    </div>
    <div>
      {
        played.length > 0 && (
          <ul class="played">
            {played.map((c) => (
              <li>
                <b>{c.title}</b>
                <span class="wh">
                  {c.city}, {formatRangeRo(c.start, c.end, { year: false })}
                  {c.home && <span class="home">acasă</span>}
                </span>
                <span class="st">jucat</span>
              </li>
            ))}
          </ul>
        )
      }
      <a class="textlink" href="/calendar/">Tot calendarul {year}</a>
    </div>
  </div>
</section>

<script>
  // The page is built once a day, so the build-time label can go stale: recompute it from the
  // visitor's clock with the same rules. Without JavaScript the build-time label stays.
  import { todayInBucharest } from '../../lib/dates';
  import { countdownLabel } from '../../lib/home';

  for (const el of document.querySelectorAll<HTMLElement>('[data-countdown]')) {
    const { start, end } = el.dataset;
    const label = start && end ? countdownLabel({ start, end }, todayInBucharest()) : undefined;
    el.textContent = label ?? '';
    el.hidden = !label;
  }
</script>

<style>
  .cal {
    background: var(--red-field);
    color: var(--white);
    padding: clamp(40px, 5.5vw, 72px) 0;
  }
  .wrap {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }
  h2 {
    margin-bottom: clamp(16px, 2.4vw, 26px);
  }
  .nextev {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(16px, 2.6vw, 32px);
    align-items: center;
  }
  .when {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(3.4rem, 7vw, 6rem);
    line-height: 0.86;
  }
  .when small {
    display: block;
    font-size: 0.27em;
    line-height: 1.1;
    margin-top: 0.2em;
    font-weight: 800;
  }
  h3 {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(1.7rem, 2.8vw, 2.5rem);
    line-height: 1;
    text-transform: uppercase;
  }
  .nextev p {
    margin-top: 4px;
  }
  .nextev .days {
    display: inline-block;
    margin-top: 12px;
    background: var(--white);
    color: var(--ink);
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.35rem;
    line-height: 1;
    padding: 9px 14px;
  }
  .nextev .days[hidden] {
    display: none;
  }
  .played {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .played li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2px 18px;
    padding: 13px 0;
    border-top: 3px solid var(--white);
  }
  .played li:last-child {
    border-bottom: 3px solid var(--white);
  }
  .played b {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1.05;
  }
  .st {
    font-size: 0.95rem;
    text-align: right;
    align-self: center;
    grid-row: 1 / 3;
    grid-column: 2;
  }
  .wh {
    font-size: 0.98rem;
  }
  .home {
    display: inline-block;
    background: var(--white);
    color: var(--red-ink);
    font-weight: 600;
    font-size: 0.85rem;
    line-height: 1;
    padding: 4px 8px;
    margin-left: 8px;
    vertical-align: 1px;
  }
  .textlink {
    display: inline-block;
    margin-top: 18px;
  }
  @media (max-width: 860px) {
    .wrap {
      grid-template-columns: 1fr;
    }
  }
</style>
