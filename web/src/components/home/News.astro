---
import { formatDateRo } from '../../lib/dates';
import { postKindLabel } from '../../lib/home';
import type { Post } from '../../lib/types';
import PlatePhoto from '../ui/PlatePhoto.astro';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const cover = posts[0]?.cover;
---

<section class="news" id="noutati" aria-labelledby="news-h">
  <div class="wrap">
    <h2 class="display" id="news-h">Noutăți</h2>
    <div class:list={['news-grid', { solo: !cover }]}>
      {cover && <PlatePhoto img={cover} offset={14} ratio="4 / 3" />}
      <div>
        {
          posts.length > 0 && (
            <ul class="nlist">
              {posts.map((post) => (
                <li>
                  <a href={`/noutati/${post.slug}/`}>
                    <span class="meta">
                      {postKindLabel(post.kind)}, <time datetime={post.date}>{formatDateRo(post.date)}</time>
                    </span>
                    <span class="title">{post.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        <a class="textlink" href="/noutati/">Toate articolele</a>
      </div>
    </div>
  </div>
</section>

<style>
  .news {
    background: var(--white);
    padding: clamp(52px, 7vw, 104px) 0;
  }
  h2 {
    color: var(--blue);
    margin-bottom: clamp(20px, 3vw, 34px);
  }
  .news-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }
  .news-grid.solo {
    grid-template-columns: minmax(0, 1fr);
  }
  .nlist {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nlist a {
    display: block;
    text-decoration: none;
    padding: 18px 0;
    border-bottom: 3px solid var(--ink);
  }
  .nlist li:first-child a {
    border-top: 3px solid var(--ink);
  }
  .meta {
    font-weight: 600;
    color: var(--red-ink);
    font-size: 0.95rem;
  }
  .title {
    display: block;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(1.6rem, 2.6vw, 2.3rem);
    line-height: 1.02;
    margin-top: 5px;
  }
  .nlist a:hover .title {
    color: var(--blue);
  }
  .textlink {
    display: inline-block;
    margin-top: 20px;
  }
  @media (max-width: 860px) {
    .news-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
