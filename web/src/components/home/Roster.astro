---
import { formatRangeRo } from '../../lib/dates';
import { HOME_ROSTER, bestRanking, disciplineLabel, pointsUnit, rosterOrder } from '../../lib/home';
import type { Athlete, Ranking, RankingWeek } from '../../lib/types';

interface Props {
  athletes: Athlete[];
  rankingWeek?: RankingWeek;
}

const { athletes, rankingWeek } = Astro.props;

/** Category and discipline; the first row also states the place, later rows the points when known. */
function rowLine(best: Ranking | undefined, isFirst: boolean): string | undefined {
  if (!best) return undefined;
  const base = `${best.category}, ${disciplineLabel(best.discipline)}`;
  if (isFirst) return `${base}. Locul ${best.place} în țară.`;
  return best.points === undefined ? base : `${base}, ${best.points} ${pointsUnit(best.points)}`;
}

const ordered = rosterOrder(athletes, HOME_ROSTER);
// Ranked athletes come first, so an unranked first athlete means nobody has a place.
const ranked = ordered.length > 0 && bestRanking(ordered[0]) !== undefined;

const rows = ordered.map((athlete, i) => {
  const best = bestRanking(athlete);
  const size = !ranked ? 'even' : i === 0 ? 'first' : i === 1 ? 'second' : 'third';
  return { athlete, best, size, line: rowLine(best, ranked && i === 0) };
});
// With places: the first row is large, the next two share a row, any others follow as compact
// rows. Without places no athlete has earned a larger row, so all rows are the same size.
const blocks = ranked
  ? [
      { kind: 'lead', rows: rows.slice(0, 1) },
      { kind: 'pair', rows: rows.slice(1, 3) },
      { kind: 'rest', rows: rows.slice(3) },
    ].filter((b) => b.rows.length > 0)
  : [{ kind: 'even-list', rows }];
---

<section class="roster" id="sportivi" aria-labelledby="ros-h">
  <div class="wrap">
    <div class="roster-head">
      <h2 class="display" id="ros-h">Unde ajung cei care continuă</h2>
      {
        rankingWeek && (
          <div class="note">
            <p>Locul fiecărui sportiv legitimat, luat din clasamentul Federației Române de Badminton.</p>
            <p class="source">
              Clasamentul FRB, săptămâna {rankingWeek.week}, {formatRangeRo(rankingWeek.from, rankingWeek.to)}
            </p>
          </div>
        )
      }
    </div>
    {
      blocks.map(({ kind, rows }) => (
        <div class={kind}>
          {rows.map(({ athlete, best, size, line }) => (
            <article class:list={[size, { unranked: !best }]}>
              {best && (
                <p class="rank">
                  <span class="visually-hidden">Locul {best.place}</span>
                  <span data-roll={best.place} aria-hidden="true">{best.place}</span>
                </p>
              )}
              <div class="who">
                <h3>{athlete.name}</h3>
                {line && <p>{line}</p>}
                {athlete.frbUrl && <a class="textlink" href={athlete.frbUrl}>Profilul FRB</a>}
              </div>
              {size === 'first' && best?.points !== undefined && (
                <p class="pts">
                  {best.points}
                  <small>{pointsUnit(best.points)}</small>
                </p>
              )}
            </article>
          ))}
        </div>
      ))
    }
    <p class="roster-foot">
      <a class="textlink" href="/sportivi/">Toți sportivii clubului</a>
      <a class="textlink" href="https://badminton.ro/clasamente/">Clasamentele pe badminton.ro</a>
    </p>
  </div>
</section>

<style>
  .roster {
    background: var(--white);
    padding: clamp(52px, 7vw, 104px) 0;
  }
  .roster-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px 40px;
    flex-wrap: wrap;
    margin-bottom: clamp(22px, 3vw, 40px);
  }
  .roster-head h2 {
    color: var(--blue);
    max-width: 16ch;
  }
  .note {
    max-width: 38ch;
    font-size: 1rem;
  }
  .source {
    margin-top: 0.5em;
    font-size: 0.92rem;
  }

  .first {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: clamp(18px, 3.5vw, 56px);
    align-items: center;
    border-top: 4px solid var(--ink);
    border-bottom: 4px solid var(--ink);
    padding: clamp(18px, 2.4vw, 30px) 0;
  }
  .pair {
    display: grid;
    grid-template-columns: 1.45fr 1fr;
    border-bottom: 4px solid var(--ink);
  }
  .second {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(16px, 2.6vw, 36px);
    align-items: center;
    padding: clamp(16px, 2vw, 26px) clamp(16px, 3vw, 40px) clamp(16px, 2vw, 26px) 0;
    border-right: 4px solid var(--ink);
  }
  .third {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(14px, 2vw, 24px);
    align-items: center;
    padding: clamp(16px, 2vw, 26px) 0 clamp(16px, 2vw, 26px) clamp(16px, 3vw, 40px);
  }
  .rest .third {
    padding-left: 0;
    border-bottom: 4px solid var(--ink);
  }
  /* Rows of equal size, used when no athlete has a place. */
  .even {
    display: grid;
    padding: clamp(16px, 2vw, 26px) 0;
    border-bottom: 4px solid var(--ink);
  }
  .even-list {
    border-top: 4px solid var(--ink);
  }
  /* Without a place there is no numeral and no column kept for it. */
  .unranked {
    grid-template-columns: minmax(0, 1fr);
  }

  .rank {
    font-family: var(--display);
    font-weight: 900;
    color: var(--blue);
    line-height: 0.86;
  }
  .rank [data-roll] {
    display: flex;
  }
  .first .rank {
    font-size: clamp(8rem, 17vw, 14rem);
    color: var(--red);
  }
  .second .rank {
    font-size: clamp(5.4rem, 10.5vw, 8.6rem);
  }
  .third .rank {
    font-size: clamp(3.4rem, 5.4vw, 4.6rem);
    color: var(--ink);
  }
  /* Digit cells the motion layer builds inside [data-roll]. */
  .rank :global(i) {
    font-style: normal;
    display: block;
    height: 0.86em;
    overflow: hidden;
  }
  .rank :global(i u) {
    text-decoration: none;
    display: block;
    height: 0.86em;
  }

  .who h3 {
    font-family: var(--display);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 0.95;
  }
  .first .who h3 {
    font-size: clamp(2.2rem, 5vw, 4.4rem);
  }
  .second .who h3 {
    font-size: clamp(1.7rem, 3.1vw, 2.7rem);
  }
  .third .who h3 {
    font-size: clamp(1.3rem, 1.9vw, 1.6rem);
  }
  .even .who h3 {
    font-size: clamp(1.7rem, 3.1vw, 2.7rem);
  }
  .who p {
    margin-top: 0.5em;
  }
  .who .textlink {
    display: inline-block;
    margin-top: 0.7em;
    font-size: 0.98rem;
  }
  .pts {
    background: var(--blue);
    color: var(--white);
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    line-height: 1;
    padding: 0.3em 0.45em 0.26em;
    text-align: center;
  }
  .pts small {
    display: block;
    font: 500 0.9rem var(--body);
    margin-top: 4px;
  }
  .roster-foot {
    margin-top: 22px;
    display: flex;
    gap: 12px 32px;
    flex-wrap: wrap;
  }

  @media (max-width: 860px) {
    .first {
      grid-template-columns: auto 1fr;
    }
    .first.unranked {
      grid-template-columns: minmax(0, 1fr);
    }
    .first .pts {
      grid-column: 1 / -1;
      justify-self: start;
    }
    .pair {
      grid-template-columns: 1fr;
    }
    .second {
      border-right: 0;
      border-bottom: 4px solid var(--ink);
      padding-right: 0;
    }
    .third {
      padding-left: 0;
    }
  }
</style>
