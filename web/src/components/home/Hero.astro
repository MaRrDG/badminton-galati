---
import type { Img } from '../../lib/types';
import PlatePhoto from '../ui/PlatePhoto.astro';

interface Props {
  lines: string[];
  text: string;
  photo?: Img;
  /** Whether the page has a roster (#sportivi) to link to. */
  rosterLink: boolean;
}

const { lines, text, photo, rosterLink } = Astro.props;

/** As in mockup D: lines at odd positions alternate .l1 / .l3, lines at even positions are .l2. */
const lineClass = (i: number) => (i % 2 === 1 ? 'l2' : i % 4 === 0 ? 'l1' : 'l3');
---

<section class="hero" aria-labelledby="hero-h">
  <div class:list={['wrap', { solo: !photo }]}>
    <div>
      <h1 class="display" id="hero-h">
        {lines.map((line, i) => (<><span class={lineClass(i)}>{line}</span>{' '}</>))}
      </h1>
      <p class="src">{text}</p>
      <p class="hero-act">
        <a class="hero-go" href="#proba">Vino la un antrenament de probă</a>
        {rosterLink && <a class="hero-more" href="#sportivi">Vezi toți sportivii</a>}
      </p>
    </div>
    {photo && <PlatePhoto class="poster" img={photo} offset={18} ratio="2 / 3" loading="eager" priority />}
  </div>
</section>

<style>
  .hero {
    background: var(--blue);
    color: var(--white);
    padding: clamp(32px, 5.5vh, 60px) 0 clamp(44px, 7vh, 76px);
    overflow: hidden;
  }
  .wrap {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: center;
  }
  .wrap.solo {
    grid-template-columns: minmax(0, 1fr);
  }
  h1 {
    position: relative;
    z-index: 3;
    font-size: clamp(3rem, 6.2vw, 5.9rem);
  }
  h1 span {
    display: block;
    white-space: nowrap;
    will-change: transform;
  }
  .src {
    margin-top: 16px;
    max-width: 46ch;
    font-size: 1rem;
  }
  .hero-act {
    margin-top: clamp(22px, 3.5vh, 34px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 26px;
  }
  .hero-go {
    background: var(--white);
    color: var(--blue);
    /* The approved mockup asked for 700 but only loaded 600, so 600 is what the client saw. */
    font-weight: 600;
    padding: 15px 22px;
    text-decoration: none;
  }
  .hero-go:focus-visible {
    outline-color: var(--white);
  }
  .hero-go:hover {
    background: var(--court);
    color: var(--ink);
  }
  .hero-more {
    color: var(--white);
    font-weight: 600;
    text-underline-offset: 5px;
  }

  /* The poster is PlatePhoto; the motion layer hooks .poster .plate, .poster .shot and .poster img. */
  .wrap > :global(.poster) {
    justify-self: end;
    width: min(100%, calc(min(64vh, 580px) * 0.667));
  }
  .wrap > :global(.poster img) {
    object-position: 50% 0;
    transform-origin: 50% 10%;
  }

  @media (max-width: 860px) {
    .wrap {
      grid-template-columns: minmax(0, 1fr);
    }
    /* A long line wraps instead of running off a narrow screen. */
    h1 span {
      white-space: normal;
      text-wrap: balance;
    }
    .wrap > :global(.poster) {
      justify-self: start;
      width: min(64vw, 300px);
    }
  }
</style>
