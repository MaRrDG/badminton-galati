---
import Base from '../layouts/Base.astro';
import RallyScene from '../components/notfound/RallyScene.astro';
import { makeLayout } from '../lib/rally/court';

// The page's strip of floor has to meet the one inside each drawing, so it takes their measures.
const measures = (['wide', 'tall'] as const)
  .map(name => {
    const L = makeLayout(name);
    return `--${name}-w:${L.w};--${name}-h:${L.h};--${name}-ground:${L.h - L.floor}`;
  })
  .join(';');

// The section pages of the menu arrive with plan 2; until then these lead to the homepage sections.
const ways = [
  { label: 'Program', href: '/#program' },
  { label: 'Calendar', href: '/#calendar' },
  { label: 'Noutăți', href: '/#noutati' },
  { label: 'Contact', href: '/#contact' },
];
---

<Base title="Pagină negăsită · CS Siderurgistul Galați" description="Pagina căutată nu există pe site-ul CS Siderurgistul Galați.">
  <section class="nf" aria-labelledby="nf-h">
    <div class="wrap nf-text">
      <h1 class="display" id="nf-h">Fluturașul a rămas în fileu</h1>
      <div>
        <p class="nf-lead">Pagina pe care o cauți nu există sau a fost mutată. Jocul continuă pe restul site-ului.</p>
        <nav class="nf-ways" aria-label="Alte pagini">
          <a class="nf-home" href="/">Înapoi acasă</a>
          <ul>
            {ways.map(way => <li><a href={way.href}>{way.label}</a></li>)}
          </ul>
        </nav>
      </div>
    </div>
    <div class="nf-court" style={measures} data-rally-stage>
      <div class="nf-frame">
        <RallyScene layout="wide" />
        <RallyScene layout="tall" />
      </div>
    </div>
  </section>
</Base>

<script>
  import { initRally } from '../scripts/rally';

  initRally();
</script>

<style>
  /* As the last section of <main> the scene takes whatever height the window has left
     (base.css): the free space opens up as sky between the text and the court, so the floor
     line stays on the footer. The drawing itself keeps its own coordinates. */
  .nf {
    background: var(--blue);
    color: var(--white);
    padding-top: clamp(28px, 4.5vh, 52px);
    display: flex;
    flex-direction: column;
  }
  .nf-text {
    width: 100%;
    margin-bottom: auto;
  }
  .nf-text {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(20px, 5vw, 80px);
    align-items: end;
  }
  h1 {
    font-size: clamp(3rem, 6.2vw, 5.9rem);
    text-wrap: balance;
  }
  .nf-lead {
    max-width: 40ch;
  }
  .nf-ways {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 26px;
  }
  .nf-home {
    background: var(--white);
    color: var(--blue);
    font-weight: 600;
    padding: 15px 22px;
    text-decoration: none;
  }
  .nf-home:hover {
    background: var(--court);
    color: var(--ink);
  }
  .nf-home:focus-visible {
    outline-color: var(--white);
  }
  .nf-ways ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
  }
  .nf-ways li a {
    font-weight: 600;
    text-underline-offset: 5px;
  }

  /* The court runs edge to edge: the frame holds the drawing, and the strip behind it carries
     the floor on to both sides at the height the drawing puts it. On a short window the frame
     narrows so the floor stays in view under the text. */
  .nf-court {
    --w: var(--wide-w);
    --h: var(--wide-h);
    --ground: var(--wide-ground);
    --frame: min(100vw, 1500px, max(820px, (100vh - 330px) * var(--w) / var(--h)));
    --unit: calc(var(--frame) / var(--w));
    position: relative;
    margin-top: clamp(4px, 1.5vh, 20px);
  }
  .nf-court::before {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: calc(var(--unit) * var(--ground));
    background: var(--blue-deep);
    border-top: calc(var(--unit) * 5) solid var(--court);
  }
  .nf-frame {
    position: relative;
    max-width: var(--frame);
    margin: 0 auto;
  }
  .nf-frame :global(.tall) {
    display: none;
  }
  /* Large screens: the page is one screen, footer included, so the drawing takes the height
     left by the header, the text and the footer (the text and footer grow with --lift), up to
     a cap that grows with the column. */
  @media (min-width: 1441px) {
    .nf-court {
      --frame: min(100vw, 1500px + var(--lift) * 0.4, max(820px, (100vh - 590px - var(--lift) * 0.06) * var(--w) / var(--h)));
    }
  }

  @media (max-width: 860px) {
    .nf-text {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
    .nf-court {
      --w: var(--tall-w);
      --h: var(--tall-h);
      --ground: var(--tall-ground);
      --frame: min(100vw, 560px);
    }
    .nf-frame :global(.wide) {
      display: none;
    }
    .nf-frame :global(.tall) {
      display: block;
    }
  }
</style>
